{
  "name": "@escapace/pnpm-pack",
  "description": "Package pnpm projects and workspaces into a .tgz archive, or extract package files to a directory.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bin": {
    "pnpm-pack": "./lib/node/cli.js"
  },
  "bugs": "https://github.com/escapace/pnpm-pack/issues",
  "dependencies": {
    "@pnpm/lockfile-file": "^9.1.3",
    "arg": "^5.0.2",
    "es-toolkit": "^1.44.0",
    "execa": "^9.6.1",
    "find-up": "^8.0.0",
    "fs-extra": "^11.3.3",
    "semver": "^7.7.3",
    "which": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "25.2.0",
    "@types/semver": "7.7.1",
    "@types/which": "3.0.4",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "10.0.0",
    "eslint-config-escapace": "5.10.2",
    "esroll": "1.1.1",
    "knip": "5.83.0",
    "lefthook": "2.1.0",
    "prettier": "3.8.1",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.29.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/pnpm-pack#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/pnpm-pack",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "node lib/node/cli.js package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
